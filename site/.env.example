DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string"

# Optional — analytics dashboard (/admin/dashboard)
# Minutes east of UTC used for "Today" / day boundaries / the busy-times grid. Default 480 (Malaysia, UTC+8).
# ANALYTICS_TZ_OFFSET_MIN="480"
# Set to 1 to NOT count visits made from localhost (handy while developing).
# ANALYTICS_EXCLUDE_LOCAL="1"

# Country lookup (offline, no npm package). The visitor's IP is used only for the moment of the lookup and is never stored or logged.
# Set to "0" to switch the lookup off (visits then show "Unknown" unless the host sends a country header).
# ANALYTICS_GEOIP="1"
# Behind a proxy/CDN the address is read from X-Forwarded-For. Set to "0" if the site is NOT behind a proxy you control.
# ANALYTICS_TRUST_PROXY="1"
# Refresh the country data monthly:  npm run geoip:update   (DB-IP "IP to Country Lite", CC BY 4.0)
